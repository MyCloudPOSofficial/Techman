    async adminToggleBranch(session, id){
      bkRequireRole(session, ['super_admin']);
      const branch = await bkGet('branches', id);
      if(!branch) throw new Error('Branch not found.');
      branch.status = branch.status === 'active' ? 'inactive' : 'active';
